# Только имена переменных. Секреты задавать локально, файл .env игнорируется.
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_ACCESS_TOKEN=
HH_USER_AGENT=
SUPERJOB_APP_ID=
SUPERJOB_APP_KEY=
# Tracing выключен: резюме и описания не должны автоматически уходить в telemetry.
LANGSMITH_TRACING=false

# Необязательные API оценщиков. Заполняйте только выбранное подключение.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
