{
  "$defs": {
    "Preference": {
      "additionalProperties": false,
      "properties": {
        "statement": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "priority": {
          "default": "preferred",
          "enum": [
            "required",
            "preferred",
            "avoid"
          ],
          "title": "Priority",
          "type": "string"
        },
        "provenance": {
          "additionalProperties": true,
          "title": "Provenance",
          "type": "object"
        },
        "structured": {
          "additionalProperties": true,
          "title": "Structured",
          "type": "object"
        }
      },
      "required": [
        "statement"
      ],
      "title": "Preference",
      "type": "object"
    },
    "ResumeInput": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "text": {
          "maxLength": 2000000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "provenance": {
          "additionalProperties": true,
          "title": "Provenance",
          "type": "object"
        }
      },
      "required": [
        "id",
        "title",
        "text"
      ],
      "title": "ResumeInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "resumes": {
      "items": {
        "$ref": "#/$defs/ResumeInput"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Resumes",
      "type": "array"
    },
    "goals": {
      "default": "",
      "maxLength": 100000,
      "title": "Goals",
      "type": "string"
    },
    "preferences": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/Preference"
          },
          {
            "type": "string"
          }
        ]
      },
      "maxItems": 1000,
      "title": "Preferences",
      "type": "array"
    },
    "attributes": {
      "additionalProperties": true,
      "title": "Attributes",
      "type": "object"
    },
    "interaction_mode": {
      "const": "unattended",
      "default": "unattended",
      "title": "Interaction Mode",
      "type": "string"
    }
  },
  "required": [
    "resumes"
  ],
  "title": "ContextInput",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-scout.local/schemas/agent-context.schema.json"
}
