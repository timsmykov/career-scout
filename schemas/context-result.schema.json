{
  "$defs": {
    "ApplicationAssessment": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "responsibility",
            "requirement"
          ],
          "title": "Kind",
          "type": "string"
        },
        "requirement": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Requirement",
          "type": "string"
        },
        "mandatory": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mandatory"
        },
        "vacancy_quote": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Vacancy Quote",
          "type": "string"
        },
        "resume_quote": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resume Quote"
        },
        "status": {
          "enum": [
            "confirmed",
            "unconfirmed",
            "conflict",
            "outside_profile"
          ],
          "title": "Status",
          "type": "string"
        },
        "explanation": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "critical": {
          "title": "Critical",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "requirement",
        "mandatory",
        "vacancy_quote",
        "resume_quote",
        "status",
        "explanation",
        "critical"
      ],
      "title": "ApplicationAssessment",
      "type": "object"
    },
    "PreferenceCheck": {
      "additionalProperties": false,
      "properties": {
        "preference_id": {
          "title": "Preference Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "met",
            "violated",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "vacancy_quote": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Vacancy Quote"
        },
        "reason": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "preference_id",
        "status",
        "vacancy_quote",
        "reason"
      ],
      "title": "PreferenceCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 4,
      "title": "Schema Version",
      "type": "integer"
    },
    "policy": {
      "const": "context-1",
      "title": "Policy",
      "type": "string"
    },
    "evaluation_key": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evaluation Key",
      "type": "string"
    },
    "profile_id": {
      "title": "Profile Id",
      "type": "string"
    },
    "verdict": {
      "enum": [
        "PASS",
        "UNCERTAIN",
        "REJECT"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "reason": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "assessments": {
      "items": {
        "$ref": "#/$defs/ApplicationAssessment"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Assessments",
      "type": "array"
    },
    "preference_checks": {
      "items": {
        "$ref": "#/$defs/PreferenceCheck"
      },
      "maxItems": 1000,
      "title": "Preference Checks",
      "type": "array"
    },
    "uncertainties": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "title": "Uncertainties",
      "type": "array"
    },
    "questions": {
      "items": {
        "type": "string"
      },
      "maxItems": 0,
      "title": "Questions",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "policy",
    "evaluation_key",
    "profile_id",
    "verdict",
    "reason",
    "assessments",
    "preference_checks",
    "uncertainties",
    "questions"
  ],
  "title": "ContextResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-scout.local/schemas/context-result.schema.json"
}
