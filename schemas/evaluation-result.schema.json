{
  "$defs": {
    "Assessment": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "responsibility",
            "requirement"
          ],
          "title": "Kind",
          "type": "string"
        },
        "requirement": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Requirement",
          "type": "string"
        },
        "mandatory": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mandatory"
        },
        "vacancy_quote": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Vacancy Quote",
          "type": "string"
        },
        "resume_quote": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resume Quote"
        },
        "status": {
          "enum": [
            "confirmed",
            "unconfirmed",
            "conflict",
            "outside_profile"
          ],
          "title": "Status",
          "type": "string"
        },
        "explanation": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "requirement",
        "mandatory",
        "vacancy_quote",
        "resume_quote",
        "status",
        "explanation"
      ],
      "title": "Assessment",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "confirmed",
                  "conflict"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "resume_quote": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unconfirmed"
              }
            }
          },
          "then": {
            "properties": {
              "resume_quote": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "evaluation_key": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evaluation Key",
      "type": "string"
    },
    "profile_id": {
      "enum": [
        "product",
        "automation",
        "business_assistant",
        "business_analyst"
      ],
      "title": "Profile Id",
      "type": "string"
    },
    "verdict": {
      "enum": [
        "PASS",
        "BORDERLINE",
        "REJECT"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "reason": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "assessments": {
      "items": {
        "$ref": "#/$defs/Assessment"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Assessments",
      "type": "array"
    },
    "questions": {
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "maxItems": 12,
      "title": "Questions",
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "evaluation_key",
    "profile_id",
    "verdict",
    "reason",
    "assessments",
    "questions"
  ],
  "title": "EvaluationResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-scout.local/schemas/evaluation-result.schema.json",
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "questions": {
            "maxItems": 0
          },
          "assessments": {
            "items": {
              "anyOf": [
                {
                  "properties": {
                    "status": {
                      "const": "confirmed"
                    }
                  }
                },
                {
                  "properties": {
                    "mandatory": {
                      "const": false
                    },
                    "kind": {
                      "const": "requirement"
                    }
                  }
                }
              ]
            },
            "contains": {
              "properties": {
                "kind": {
                  "const": "responsibility"
                },
                "status": {
                  "const": "confirmed"
                }
              }
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "BORDERLINE"
          }
        }
      },
      "then": {
        "properties": {
          "questions": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "REJECT"
          }
        }
      },
      "then": {
        "properties": {
          "assessments": {
            "contains": {
              "anyOf": [
                {
                  "properties": {
                    "mandatory": {
                      "const": true
                    },
                    "status": {
                      "const": "conflict"
                    }
                  }
                },
                {
                  "properties": {
                    "kind": {
                      "const": "responsibility"
                    },
                    "mandatory": {
                      "enum": [
                        true,
                        null
                      ]
                    },
                    "status": {
                      "const": "outside_profile"
                    }
                  }
                }
              ]
            },
            "minContains": 1
          }
        }
      }
    }
  ]
}
