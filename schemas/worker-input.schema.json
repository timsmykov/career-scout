        "source_payload": {
          "additionalProperties": true,
          "title": "Source Payload",
          "type": "object"
        },
        "conditions": {
          "additionalProperties": true,
          "title": "Conditions",
          "type": "object"
        },
        "attributes": {
          "$ref": "#/$defs/Attributes"
        },
        "published_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Published At"
