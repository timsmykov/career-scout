        "detail_fetched_at": {
          "title": "Detail Fetched At",
          "type": "string"
        },
        "detail_status": {
          "enum": [
            "full",
            "archived"
          ],
          "title": "Detail Status",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "source_normalizer_version": {
          "title": "Source Normalizer Version",
          "type": "string"
        },
        "normalizer_version": {
          "const": "common-1",
          "default": "common-1",
          "title": "Normalizer Version",
          "type": "string"
        },
        "normalization_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Normalization Hash",
          "type": "string"
        }
      },
      "required": [
        "source",
        "source_id",
        "title",
        "company",
        "url",
        "description",
        "description_html",
        "source_payload",
        "conditions",
        "attributes",
        "published_at",
        "created_at",
        "source_updated_at",
        "detail_fetched_at",
        "detail_status",
        "content_hash",
        "source_normalizer_version",
        "normalization_hash"
      ],
      "title": "Vacancy",
      "type": "object"
