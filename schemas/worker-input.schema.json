{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-scout.local/schemas/worker-input.schema.json",
  "title": "WorkerInput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_key",
    "profile_id",
    "vacancy",
    "resume",
    "filter_version",
    "filters",
    "rubric_version",
    "model_config_hash",
    "evaluator_version",
    "evaluation_date"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "evaluation_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile_id": {
      "enum": [
        "product",
        "business_analyst",
        "business_assistant",
        "automation"
      ]
    },
    "vacancy": {
      "$ref": "vacancy-snapshot.schema.json"
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resume_id",
        "version",
        "content_hash",
        "text"
      ],
      "properties": {
        "resume_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "filter_version": {
      "type": "string",
      "minLength": 1
    },
    "filters": {
      "type": "object"
    },
    "rubric_version": {
      "type": "string",
      "minLength": 1
    },
    "model_config_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evaluator_version": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "properties": {
        "vacancy": {
          "properties": {
            "detail_status": {
              "const": "full"
            }
          }
        }
      }
    }
  ]
}
