{
  "$defs": {
    "Attributes": {
      "additionalProperties": false,
      "properties": {
        "salary": {
          "anyOf": [
            {
              "$ref": "#/$defs/Salary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "experience": {
          "anyOf": [
            {
              "$ref": "#/$defs/Experience"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "work_formats": {
          "items": {
            "enum": [
              "on_site",
              "remote",
              "hybrid",
              "field_work",
              "rotation"
            ],
            "type": "string"
          },
          "title": "Work Formats",
          "type": "array"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "conflicts": {
          "items": {
            "type": "string"
          },
          "title": "Conflicts",
          "type": "array"
        },
        "field_sources": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Field Sources",
          "type": "object"
        }
      },
      "title": "Attributes",
      "type": "object"
    },
    "Experience": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "anyOf": [
            {
              "enum": [
                "no_experience",
                "one_to_three",
                "three_to_six",
                "over_six"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "min_years": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ],
              "ge": 0
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Years"
        },
        "max_years": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ],
              "ge": 0
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Years"
        },
        "min_inclusive": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Inclusive"
        },
        "max_inclusive": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Inclusive"
        }
      },
      "title": "Experience",
      "type": "object"
    },
    "ResumeSnapshot": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "enum": [
            "product",
            "automation",
            "business_assistant",
            "business_analyst"
          ],
          "title": "Profile Id",
          "type": "string"
        },
        "resume_id": {
          "minLength": 1,
          "title": "Resume Id",
          "type": "string"
        },
        "source_url": {
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "provenance": {
          "additionalProperties": true,
          "title": "Provenance",
          "type": "object"
        }
      },
      "required": [
        "profile_id",
        "resume_id",
        "source_url",
        "title",
        "version",
        "captured_at",
        "content_hash",
        "text",
        "provenance"
      ],
      "title": "ResumeSnapshot",
      "type": "object"
    },
    "Salary": {
      "additionalProperties": false,
      "properties": {
        "amount_from": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ],
              "ge": 0
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount From"
        },
        "amount_to": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ],
              "ge": 0
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount To"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "gross": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gross"
        },
        "period": {
          "anyOf": [
            {
              "enum": [
                "hour",
                "shift",
                "day",
                "week",
                "month",
                "year",
                "rotation",
                "service",
                "project"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period"
        },
        "payout_frequency": {
          "anyOf": [
            {
              "enum": [
                "daily",
                "weekly",
                "twice_monthly",
                "monthly",
                "per_project"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payout Frequency"
        }
      },
      "title": "Salary",
      "type": "object"
    },
    "Vacancy": {
